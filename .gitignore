# Python bytecode and caches (regenerated on every run; never source of truth)
__pycache__/
*.py[cod]
*.pyo

# Test/tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local virtual environments
.venv/
venv/
env/

# Editor / OS cruft
.DS_Store
*.swp
*~

# NOTE: drizzle_state.json is intentionally tracked. It is the entire track
# record; the workflow commits it back after every run and git history is its
# backup. Do NOT add it here. The docs/ pages are the deployed Pages site and
# are likewise committed on purpose.
